# 目标账号（同事那边）的配置。复制成 .env.target 后填，然后一条命令就能把整套 Base 搬过去：
#
#   cp .env.target.example .env.target
#   uv run python scripts/migrate_base.py --target-env .env.target --dry-run
#   uv run python scripts/migrate_base.py --target-env .env.target --apply
#
# .env.target 含密钥，已在 .gitignore 里（.env.target 和 .env.target.*）——不要提交。
#
# ─────────────────────────────────────────────────────────────
#  只需要填这一节里的三个值（第 1、2 项），其余全部留空即可。
# ─────────────────────────────────────────────────────────────

# ── ① 应用凭证：在**同事的**飞书账号里建一个自建应用 ──────────────
#    去哪建：https://open.feishu.cn/app  →  「创建企业自建应用」（名字随便，比如 CRM-BaseBot）
#    去哪抄：建好后进应用 → 左侧「凭证与基础信息」→ 复制 App ID / App Secret 贴到下面
#
#    两个必做的开通动作（漏了会得到 403，而报错完全看不出是这个原因）：
#      a. 权限：左侧「权限管理」→ 搜「多维表格」→ 开通 bitable:app（读写）
#      b. 发版：左侧「版本管理与发布」→ 创建版本 → 申请发布（自建企业应用通常需管理员点一下）
#    （不需要把应用加成 Base 的协作者 —— 下面 --create-base 会用一个应用自己建的 Base）
LARK_APP_ID=
LARK_APP_SECRET=

# ── ② Base：两种走法，二选一 ─────────────────────────────────
#   走法 A（推荐，最省事）：什么都不填，命令里加 --create-base "CRM 佣金看板"
#           迁移会用这个应用**新建**一个 Base，并把 token 自动写回本文件。
#
#   走法 B：同事自己先建一个空 Base（他自己建的才在他空间里看得见），
#           然后把这个空 Base 的 URL 里的那段 token 填到下面：
#             https://xxx.feishu.cn/base/<就是这一段>?table=tblXXXX
#           走 B 的话要记得把应用加进这个 Base 的协作者（可编辑），否则 403。
LARK_BASE_APP_TOKEN=

# ── ③ 时区：归月、交易日都按它算 ─────────────────────────────
#    除非业务不在新加坡，否则别改（改错了月份会把 8 月的钱算进 7 月，而且不报错）。
BUSINESS_TIMEZONE=Asia/Singapore

# ── 下面全部可以留空 ─────────────────────────────────────────
# 表 id：迁移按**表名**自己找，不用填。迁移跑完会打印真实的 id，需要时再回填。
TABLE_REFERRAL=
TABLE_CLIENT=
TABLE_DAILY_BOARD=
TABLE_COMMISSION=
TABLE_AUDIT=
TABLE_SALES=

# 渠道编号是文本列（现成的 R001-R101），只有把那一列改成 Bitable 自动编号才填 true。
REFERRAL_AUTO_NUMBER=false

# 国际版 Lark（不是飞书）才改成 https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# ── 第二轮才需要：日常自动跑批（邮件取数）──────────────────────
# Base 搬过去、机器人跑起来之后，如果要让目标账号**每天自动**取数导入，
# 再填这四个 Microsoft Graph 键（同一套 Entra 应用凭证可以复用，见 docs/PIPELINE.md）。
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_USER_ID=

# 内部系统（AI Smart Analyst）的发件人地址。留空用代码里的默认值。
GRAPH_SENDER=

# 每日增量导入去哪个目录找导出文件；--from-mail 抓下来的附件也落这里。
DAILY_EXPORT_DIR=attachments
