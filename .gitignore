# 凭证 — 绝不入库
.env
*.pem
*.key
# .env 的备份/历史文件同样含密钥。只写 .env 挡不住 .env.bak-20260919-173352 这种名字，
# 而那些文件里有真的密钥 —— 2026-09-19 拷 Graph 凭证时踩到过。
.env.bak-*
.env.*.bak
# 迁移目标端的环境文件（另一个账号的应用凭证 + Base token），同样含密钥
.env.target
.env.target.*
# 但模板要进仓库 —— 同事 clone 下来才有可填的东西（上面那条会连模板一起挡掉）
!.env.target.example

# Base 探查产物可能含真实客户数据
schema_snapshot*.json
!schema_snapshot.example.json
out/

# 业务数据导出，含真实客户信息，绝不入库
*.xlsx
*.xls
*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
# 跑覆盖率留下的数据库和报告，每次重跑都会重新生成
.coverage
.coverage.*
htmlcov/

# macOS
.DS_Store

# 主目录里手工放进来的临时产物，不是项目内容
/CRM-BaseBot-*.zip
/UID

# 每日跑批的产物：抓下来的附件（*.xlsx 已在上面忽略）和 launchd 日志
/attachments/
/logs/
