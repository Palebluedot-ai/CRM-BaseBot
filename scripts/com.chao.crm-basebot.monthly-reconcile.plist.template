<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  每月结算上个月的佣金，写进 Commission Summary 并通知管理员。
  用 scripts/install-monthly-reconcile-launchd.sh 安装。

  为什么是 1 号 16:30（2026-10-02 起，以前是 3 号 10:00）：结算表现在每天都更新
  （当月标「进行中」，见 jobs/live_summary.py），不用再等。上个月最后一天的交易，
  那封邮件第二天早上才到 —— 1 号 10:45、16:00 两趟导入之后一般已经进了看板，
  16:30 再结，把上个月改成「已结算」、存档、发卡片。
  16:00 那趟导入通常几分钟就跑完；万一那天邮件特别晚，最后一天会漏，
  要用 monthly_reconcile.py --period YYYY-MM 配合 jobs.reconcile --replace 重结。

  WorkingDirectory 必须是仓库根目录：Settings 读的是相对路径 .env。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chao.crm-basebot.monthly-reconcile</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Day</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>16</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/monthly-reconcile-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__LOGDIR__/monthly-reconcile-stderr.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <!-- 只管日志时间戳和 launchd 的日历触发点；结算月份按 .env 的 BUSINESS_TIMEZONE 算 -->
    <key>TZ</key>
    <string>Asia/Hong_Kong</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
