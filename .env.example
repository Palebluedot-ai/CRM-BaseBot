# 复制成 .env 后填写。.env 已在 .gitignore 里，绝不要提交。
#
# 阶段 A 用你自建的免费飞书组织，阶段 C 换成公司组织的凭证，代码不动。
# 获取方式见 docs/LARK_APP_SETUP.md

# 开发者后台 > 凭证与基础信息
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=

# 多维表格 URL 里的那段 token：
#   https://xxx.feishu.cn/base/<APP_TOKEN>?table=<TABLE_ID>&view=...
LARK_BASE_APP_TOKEN=

# 各表的 table_id。先留空，跑 `uv run python scripts/inspect_base.py` 探查后回填。
TABLE_REFERRAL=
TABLE_CLIENT=
TABLE_DAILY_BOARD=
TABLE_COMMISSION=
TABLE_AUDIT=
TABLE_SALES=

# 销售收入日读看板 xlsx 的默认路径。scripts/import_daily_board.py 用它，
# 也可以在命令行用 --file 覆盖。
DAILY_BOARD_XLSX=

# 渠道编号交给 Bitable 的自动编号字段生成（推荐）。
# 如果 `scripts/verify_numbering.py --probe` 实测发现对不齐现有 R001-R009，
# 改成 false 走后端串行递增。
REFERRAL_AUTO_NUMBER=true

# 对账归月用的时区，IANA 名字。Bitable 日期字段存的是 UTC 时间戳，
# 不换算的话每个月 1 号 0 点到 8 点的交易会算进上个月。
BUSINESS_TIMEZONE=Asia/Singapore

# 国际版 Lark 改成 https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
