# 复制成 .env 后填写。.env 已在 .gitignore 里，绝不要提交。
#
# 阶段 A 用你自建的免费飞书组织，阶段 C 换成公司组织的凭证，代码不动。
# 获取方式见 docs/LARK_APP_SETUP.md

# 开发者后台 > 凭证与基础信息
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=

# 多维表格 URL 里的那段 token：
#   https://xxx.feishu.cn/base/<APP_TOKEN>?table=<TABLE_ID>&view=...
LARK_BASE_APP_TOKEN=

# 各表的 table_id。先留空，跑 `uv run python scripts/inspect_base.py` 探查后回填。
TABLE_REFERRAL=
TABLE_CLIENT=
TABLE_TRANSACTION=
TABLE_COMMISSION=
TABLE_AUDIT=
TABLE_SALES=

# 国际版 Lark 改成 https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
