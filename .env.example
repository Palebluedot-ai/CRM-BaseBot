# 复制成 .env 后填写。.env 已在 .gitignore 里，绝不要提交。
#
# 阶段 A 用你自建的免费飞书组织，阶段 C 换成公司组织的凭证，代码不动。
# 获取方式见 docs/LARK_APP_SETUP.md

# 开发者后台 > 凭证与基础信息
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=

# 多维表格 URL 里的那段 token：
#   https://xxx.feishu.cn/base/<APP_TOKEN>?table=<TABLE_ID>&view=...
LARK_BASE_APP_TOKEN=

# 各表的 table_id。先留空，跑 `uv run python scripts/inspect_base.py` 探查后回填。
TABLE_REFERRAL=
TABLE_CLIENT=
TABLE_DAILY_BOARD=
TABLE_COMMISSION=
TABLE_AUDIT=
TABLE_SALES=

# 内部系统导出的交易明细 xlsx 的默认路径。scripts/import_daily_board.py 用它，
# 也可以在命令行用 --file 覆盖。
DAILY_BOARD_XLSX=

# 每日增量导入（scripts/import_daily_incremental.py）在哪个目录找导出文件。
# --from-mail 抓下来的附件也落在这里。相对路径按仓库根目录算。
DAILY_EXPORT_DIR=attachments

# 邮件抓取：Microsoft Graph 的**应用权限**（不是用户授权，没有人在旁边点同意）。
# 四个键齐了才能用 --from-mail；缺了只影响这一条路，手工 --file 导入照常。
#   · 应用需要在 Entra 里被授予 Mail.Read（应用程序权限）并限定到下面这个邮箱
#   · 密钥只放本地 .env：不要提交，也不要贴进聊天/日志
# 具体步骤见 docs/PIPELINE.md
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_USER_ID=

# 内部系统（AI Smart Analyst）的发件人地址。留空用代码里的默认值。
GRAPH_SENDER=

# 渠道编号是文本列，现成的 R001-R101 从模板导入，机器人新登记时从最大号 +1 串行递增。
# 只有把那一列重建成 Bitable 的自动编号字段时才改成 true。
REFERRAL_AUTO_NUMBER=false

# 对账归月用的时区，IANA 名字。Bitable 日期字段存的是 UTC 时间戳，
# 不换算的话每个月 1 号 0 点到 8 点的交易会算进上个月。
BUSINESS_TIMEZONE=Asia/Singapore

# 国际版 Lark 改成 https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
